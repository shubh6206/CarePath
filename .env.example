# ==============================================================================
# CarePath Environment Variables Template
# ==============================================================================
# LOCAL DEVELOPMENT (Default, NO AWS Account Required):
# Run `docker compose up -d` to launch LocalStack, then `npm run dev`.
# ==============================================================================

# GEMINI_API_KEY: Optional fallback for local clinical structuring
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Node / App Config
PORT=3000
NODE_ENV=development

# AWS Region (used for both LocalStack and AWS)
AWS_REGION=us-east-1

# LocalStack Dummy Credentials (do NOT use real credentials here)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# LocalStack Service Endpoints
LOCALSTACK_ENDPOINT=http://localhost:4566
S3_ENDPOINT=http://localhost:4566
DYNAMODB_ENDPOINT=http://localhost:4566
SNS_ENDPOINT=http://localhost:4566

# S3 Document Ingestion Bucket
S3_BUCKET_NAME=carepath-documents

# DynamoDB Table Names
DYNAMODB_TABLE_NAME=carepath-documents
DYNAMODB_TABLE_PATIENTS=carepath-patients
DYNAMODB_TABLE_DOCUMENTS=carepath-documents
DYNAMODB_TABLE_TASKS=carepath-tasks
DYNAMODB_TABLE_CHECKINS=carepath-checkins

# SNS Caregiver Alerts Topic
SNS_TOPIC_NAME=carepath-caregiver-alerts
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:carepath-caregiver-alerts

# Execution Modes ('local' vs 'aws')
STORAGE_MODE=localstack
TEXTRACT_MODE=local
BEDROCK_MODE=local
NOTIFICATION_MODE=local
DEMO_MODE=true

# ==============================================================================
# OPTIONAL: FUTURE AWS DEPLOYMENT (Milestone 4 - Live AWS Services)
# Fill these only if deploying to real AWS:
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# Optional override; defaults to anthropic.claude-3-5-sonnet-20241022-v2:0, then the
# us.anthropic.claude-3-5-sonnet-20241022-v2:0 inference profile
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# STORAGE_MODE=aws
# TEXTRACT_MODE=aws
# BEDROCK_MODE=aws
# NOTIFICATION_MODE=aws
# ==============================================================================
